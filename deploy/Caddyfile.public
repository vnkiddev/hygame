# Caddyfile cho tên miền CÔNG CỘNG (hygame.vnkid.dev).
# Chép vào /etc/caddy/Caddyfile rồi: sudo systemctl reload caddy
#
# Khác bản LAN ở hai chỗ:
#   - cert Let's Encrypt thật -> iPad KHÔNG phải cài chứng chỉ gốc nữa
#   - đã mở ra internet thì BẮT BUỘC đặt ADMIN_TOKEN (xem scripts/deploy.sh)

hygame.vnkid.dev {
	encode gzip

	# Nhận IP thật của khách khi đứng sau Cloudflare, để log có nghĩa.
	# CHỈ tin header này khi thật sự có proxy đứng trước.
	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
		103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 \
		188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 \
		104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
		2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
		2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Video thưởng — cần Range để tua được
	handle /media/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv/kidsapp/frontend
		try_files {path} {path}/ /index.html
		file_server

		@nocache path *.json *.js *.css *.html *.txt
		header @nocache Cache-Control "no-cache"
		@static path /core/fonts/*
		header @static Cache-Control "public, max-age=31536000, immutable"
	}

	log {
		output file /var/log/caddy/hygame.log
		format console
	}
}
